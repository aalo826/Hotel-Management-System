<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #f7f5f0; -fx-background: #f7f5f0;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.senecacollege.application.hotelmanagementsystem.controller.WaitlistController">

    <VBox spacing="24" style="-fx-background-color: #f7f5f0; -fx-padding: 32;">

        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"
               text="Waitlist Management" />

        <!-- Filters + Add button -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: #e8e0d0; -fx-border-width: 1;
                     -fx-border-radius: 10; -fx-background-radius: 10;
                     -fx-padding: 16;">
            <Label style="-fx-font-size: 13px; -fx-text-fill: #888888;" text="Room Type:" />
            <ComboBox fx:id="waitlistRoomTypeFilter" prefWidth="140" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #888888;" text="From:" />
            <DatePicker fx:id="waitlistDateFrom" prefWidth="160" />
            <Label style="-fx-font-size: 13px; -fx-text-fill: #888888;" text="To:" />
            <DatePicker fx:id="waitlistDateTo" prefWidth="160" />
            <Button onAction="#handleWaitlistFilter"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #c9a84c;
                           -fx-border-color: #c9a84c; -fx-border-width: 1.5;
                           -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-font-size: 13px; -fx-padding: 8 20; -fx-cursor: hand;"
                    text="Filter" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleAddToWaitlist"
                    style="-fx-background-color: #c9a84c; -fx-text-fill: #ffffff;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-padding: 8 20; -fx-background-radius: 6; -fx-cursor: hand;"
                    text="+ Add to Waitlist" />
        </HBox>

        <!-- Waitlist table -->
        <TableView fx:id="waitlistTable" prefHeight="420"
                   style="-fx-background-color: #ffffff;
                          -fx-border-color: #e8e0d0; -fx-border-width: 1;
                          -fx-border-radius: 10; -fx-background-radius: 10;">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

            <columns>
                <TableColumn fx:id="waitColId"       prefWidth="60"  text="#" />
                <TableColumn fx:id="waitColName"     prefWidth="160" text="Guest Name" />
                <TableColumn fx:id="waitColPhone"    prefWidth="130" text="Phone" />
                <TableColumn fx:id="waitColRoomType" prefWidth="180" minWidth="150" text="Room Type" />
                <TableColumn fx:id="waitColCheckIn"  prefWidth="110" text="Check-in" />
                <TableColumn fx:id="waitColCheckOut" prefWidth="110" text="Check-out" />
                <TableColumn fx:id="waitColAddedOn"  prefWidth="110" text="Added On" />
                <TableColumn fx:id="waitColStatus"   prefWidth="120" text="Status" />
                <TableColumn fx:id="waitColActions"  prefWidth="150" text="Actions" />
            </columns>
            <placeholder>
                <Label style="-fx-text-fill: #aaaaaa;" text="No waitlist entries." />
            </placeholder>
        </TableView>

    </VBox>
</ScrollPane>
