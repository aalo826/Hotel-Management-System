<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ca.senecacollege.application.hotelmanagementsystem.controller.FeedbackController"
            prefWidth="1400" prefHeight="900"
            style="-fx-background-color: #ffffff;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          prefHeight="70"
          style="-fx-background-color: #ffffff;
                 -fx-border-color: transparent transparent #e8e0d0 transparent;
                 -fx-border-width: 0 0 1.5 0;
                 -fx-padding: 0 60;">
        <Label text="AURORA GRAND HOTEL"
               style="-fx-font-size: 18px; -fx-font-weight: bold;
                      -fx-text-fill: #1a1a1a; -fx-letter-spacing: 2px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Guest Feedback"
               style="-fx-font-size: 13px; -fx-text-fill: #c9a84c; -fx-letter-spacing: 1px;"/>
    </HBox>

    <!-- ═══ FEEDBACK FORM PANE ═══ -->
    <VBox fx:id="feedbackFormPane"
          alignment="CENTER" spacing="32"
          AnchorPane.topAnchor="70" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <VBox alignment="CENTER" spacing="28" maxWidth="640"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: #e8e0d0;
                     -fx-border-width: 1.5;
                     -fx-border-radius: 12;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                     -fx-padding: 48;">

            <!-- Title -->
            <VBox alignment="CENTER" spacing="8">
                <Label text="Share Your Experience"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                <Label text="Please rate your stay at Aurora Grand Hotel"
                       style="-fx-font-size: 14px; -fx-text-fill: #888888;"/>
                <Region prefHeight="4"/>
                <Region prefWidth="60" prefHeight="2"
                        style="-fx-background-color: #c9a84c;"/>
            </VBox>

            <!-- Star Rating -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="STAR RATING"
                       style="-fx-font-size: 11px; -fx-text-fill: #c9a84c;
                              -fx-letter-spacing: 2px; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER" spacing="12">
                    <Label fx:id="star1" text="&#9734;"
                           onMouseClicked="#handleStar1"
                           style="-fx-text-fill: #d1d5db; -fx-font-size: 40px; -fx-cursor: hand;"/>
                    <Label fx:id="star2" text="&#9734;"
                           onMouseClicked="#handleStar2"
                           style="-fx-text-fill: #d1d5db; -fx-font-size: 40px; -fx-cursor: hand;"/>
                    <Label fx:id="star3" text="&#9734;"
                           onMouseClicked="#handleStar3"
                           style="-fx-text-fill: #d1d5db; -fx-font-size: 40px; -fx-cursor: hand;"/>
                    <Label fx:id="star4" text="&#9734;"
                           onMouseClicked="#handleStar4"
                           style="-fx-text-fill: #d1d5db; -fx-font-size: 40px; -fx-cursor: hand;"/>
                    <Label fx:id="star5" text="&#9734;"
                           onMouseClicked="#handleStar5"
                           style="-fx-text-fill: #d1d5db; -fx-font-size: 40px; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- Comments -->
            <VBox spacing="8" maxWidth="560">
                <Label text="COMMENTS"
                       style="-fx-font-size: 11px; -fx-text-fill: #c9a84c;
                              -fx-letter-spacing: 2px; -fx-font-weight: bold;"/>
                <TextArea fx:id="commentsArea"
                          promptText="Tell us about your stay..."
                          prefRowCount="5"
                          wrapText="true"
                          style="-fx-background-color: #fafafa;
                                 -fx-border-color: #e0d8cc;
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;
                                 -fx-padding: 12;
                                 -fx-font-size: 14px;"/>
            </VBox>

            <!-- Error label -->
            <Label fx:id="errorLabel" text="" visible="false"
                   style="-fx-text-fill: #c62828; -fx-font-size: 13px;"/>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="16">
                <Button text="Back to Kiosk"
                        onAction="#handleBackToWelcome"
                        style="-fx-background-color: #f0ebe3;
                               -fx-text-fill: #555555;
                               -fx-border-radius: 8;
                               -fx-background-radius: 8;
                               -fx-font-size: 13px;
                               -fx-padding: 11 24;
                               -fx-cursor: hand;"/>
                <Button text="Submit Feedback"
                        onAction="#handleSubmitFeedback"
                        style="-fx-background-color: #ffffff;
                               -fx-text-fill: #c9a84c;
                               -fx-border-color: #c9a84c;
                               -fx-border-width: 1.5;
                               -fx-border-radius: 8;
                               -fx-background-radius: 8;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-padding: 13 48;
                               -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- ═══ FEEDBACK CONFIRMED PANE ═══ -->
    <VBox fx:id="feedbackConfirmedPane"
          alignment="CENTER" spacing="28"
          visible="false"
          AnchorPane.topAnchor="70" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <VBox alignment="CENTER" spacing="20" maxWidth="560"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: #e8e0d0;
                     -fx-border-width: 1.5;
                     -fx-border-radius: 12;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 20, 0, 0, 4);
                     -fx-padding: 56;">

            <Label text="&#10003;"
                   style="-fx-text-fill: #c9a84c; -fx-font-size: 64px; -fx-font-weight: bold;"/>

            <Label text="Thank You!"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>

            <Region prefWidth="60" prefHeight="2"
                    style="-fx-background-color: #c9a84c;"/>

            <Label text="Thank you for your feedback! Your submission has been confirmed."
                   wrapText="true" textAlignment="CENTER"
                   style="-fx-font-size: 15px; -fx-text-fill: #888888;"/>

            <Button text="Home"
                    onAction="#handleBackToWelcome"
                    style="-fx-background-color: #ffffff;
                           -fx-text-fill: #c9a84c;
                           -fx-border-color: #c9a84c;
                           -fx-border-width: 1.5;
                           -fx-border-radius: 8;
                           -fx-background-radius: 8;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-padding: 13 36;
                           -fx-cursor: hand;"/>
        </VBox>
    </VBox>

</AnchorPane>
