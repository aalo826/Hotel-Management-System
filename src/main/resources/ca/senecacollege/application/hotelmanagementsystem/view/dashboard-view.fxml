<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableView?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #f7f5f0; -fx-background: #f7f5f0;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.senecacollege.application.hotelmanagementsystem.controller.DashboardController">

    <VBox spacing="24" style="-fx-background-color: #f7f5f0; -fx-padding: 32;">

        <!-- Top bar -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: transparent transparent #e8e0d0 transparent;
                     -fx-border-width: 0 0 1.5 0;
                     -fx-padding: 12 40;">
            <Label fx:id="adminTitleLabel"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;
                          -fx-text-fill: #1a1a1a; -fx-letter-spacing: 2px;"
                   text="AURORA GRAND HOTEL" />
            <Region HBox.hgrow="ALWAYS" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: #c9a84c; -fx-letter-spacing: 1px;"
                   text="Admin Portal" />
            <Button onAction="#handleSettings"
                    style="-fx-background-color: #fafafa; -fx-text-fill: #555555;
                           -fx-border-color: #e0d8cc; -fx-border-width: 1;
                           -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-font-size: 12px; -fx-padding: 7 16; -fx-cursor: hand;"
                    text="Settings" />
            <Button onAction="#handleLogout"
                    style="-fx-background-color: #ffffff; -fx-text-fill: #c9a84c;
                           -fx-border-color: #c9a84c; -fx-border-width: 1.5;
                           -fx-border-radius: 6; -fx-background-radius: 6;
                           -fx-font-size: 12px; -fx-padding: 7 16; -fx-cursor: hand;"
                    text="Log Out" />
        </HBox>

        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"
               text="Dashboard" />

        <!-- Search / Filters -->
        <VBox spacing="14"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: #e8e0d0; -fx-border-width: 1;
                     -fx-border-radius: 10; -fx-background-radius: 10;
                     -fx-padding: 20;">
            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #555555;"
                   text="Search / Filters" />
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #888888;" text="Name:" />
                <TextField fx:id="dashNameFilter" prefWidth="180" promptText="Guest name"
                           style="-fx-padding: 8 12; -fx-border-color: #e0d8cc;
                                  -fx-border-radius: 6; -fx-background-radius: 6;" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #888888;" text="Phone:" />
                <TextField fx:id="dashPhoneFilter" prefWidth="160" promptText="Phone"
                           style="-fx-padding: 8 12; -fx-border-color: #e0d8cc;
                                  -fx-border-radius: 6; -fx-background-radius: 6;" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #888888;" text="Date:" />
                <DatePicker fx:id="dashDateFilter" prefWidth="170" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label style="-fx-font-size: 13px; -fx-text-fill: #888888;" text="Status:" />
                <ComboBox fx:id="dashStatusFilter" prefWidth="130" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #888888;" text="Room Type:" />
                <ComboBox fx:id="dashRoomTypeFilter" prefWidth="130" />
                <Button onAction="#handleDashboardSearch"
                        style="-fx-background-color: #ffffff; -fx-text-fill: #c9a84c;
                               -fx-border-color: #c9a84c; -fx-border-width: 1.5;
                               -fx-border-radius: 6; -fx-background-radius: 6;
                               -fx-font-size: 13px; -fx-padding: 8 20; -fx-cursor: hand;"
                        text="Search" />
                <Button onAction="#handleDashboardReset"
                        style="-fx-background-color: #fafafa; -fx-text-fill: #888888;
                               -fx-border-color: #e0d8cc; -fx-border-width: 1;
                               -fx-border-radius: 6; -fx-background-radius: 6;
                               -fx-font-size: 13px; -fx-padding: 8 20; -fx-cursor: hand;"
                        text="Reset" />
            </HBox>
        </VBox>

        <!-- Reservations table -->
        <VBox spacing="12"
              style="-fx-background-color: #ffffff;
                     -fx-border-color: #e8e0d0; -fx-border-width: 1;
                     -fx-border-radius: 10; -fx-background-radius: 10;
                     -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"
                       text="Reservations" />
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleNewReservation"
                        style="-fx-background-color: #c9a84c; -fx-text-fill: #ffffff;
                               -fx-font-size: 12px; -fx-font-weight: bold;
                               -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"
                        text="+ New Reservation" />
            </HBox>
            <TableView fx:id="dashReservationTable" prefHeight="300"
                       style="-fx-border-color: #e8e0d0; -fx-border-radius: 6;">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="dashColName"    prefWidth="160" text="Guest Name" />
                    <TableColumn fx:id="dashColPhone"   prefWidth="120" text="Phone" />
                    <TableColumn fx:id="dashColRoom"    prefWidth="100" text="Room" />
                    <TableColumn fx:id="dashColCheckIn" prefWidth="110" text="Check-in" />
                    <TableColumn fx:id="dashColCheckOut" prefWidth="110" text="Check-out" />
                    <TableColumn fx:id="dashColStatus"  prefWidth="110" text="Status" />
                    <TableColumn fx:id="dashColBalance" prefWidth="100" text="Balance" />
                    <TableColumn fx:id="dashColActions" prefWidth="220" text="Actions" />
                </columns>
                <placeholder>
                    <Label style="-fx-text-fill: #aaaaaa;" text="No reservations found." />
                </placeholder>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
