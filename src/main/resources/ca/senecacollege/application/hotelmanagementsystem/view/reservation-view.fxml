<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #f7f5f0; -fx-background: #f7f5f0;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.senecacollege.application.hotelmanagementsystem.controller.ReservationController">

    <VBox spacing="24" style="-fx-background-color: #f7f5f0; -fx-padding: 32;">

        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"
               text="New Reservation" />

        <HBox alignment="TOP_LEFT" spacing="24">

            <!-- Guest info + booking form -->
            <VBox spacing="18"
                  style="-fx-background-color: #ffffff;
                         -fx-border-color: #e8e0d0; -fx-border-width: 1;
                         -fx-border-radius: 10; -fx-background-radius: 10;
                         -fx-padding: 24;"
                  HBox.hgrow="ALWAYS">

                <Label style="-fx-font-size: 15px; -fx-font-weight: bold;
                              -fx-text-fill: #c9a84c; -fx-letter-spacing: 1px;"
                       text="Guest Info" />

                <HBox spacing="16">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="First Name" />
                        <TextField fx:id="resFirstName" promptText="First name"
                                   style="-fx-padding: 9 12; -fx-border-color: #e0d8cc;
                                          -fx-border-radius: 6; -fx-background-radius: 6;" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Last Name" />
                        <TextField fx:id="resLastName" promptText="Last name"
                                   style="-fx-padding: 9 12; -fx-border-color: #e0d8cc;
                                          -fx-border-radius: 6; -fx-background-radius: 6;" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Phone" />
                        <TextField fx:id="resPhone" promptText="Phone"
                                   style="-fx-padding: 9 12; -fx-border-color: #e0d8cc;
                                          -fx-border-radius: 6; -fx-background-radius: 6;" />
                    </VBox>
                </HBox>

                <HBox spacing="16">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Email" />
                        <TextField fx:id="resEmail" promptText="Email"
                                   style="-fx-padding: 9 12; -fx-border-color: #e0d8cc;
                                          -fx-border-radius: 6; -fx-background-radius: 6;" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Loyalty Member" />
                        <CheckBox fx:id="resLoyaltyStatus" text="Is Member" />
                    </VBox>
                </HBox>

                <HBox spacing="16">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Check-in" />
                        <DatePicker fx:id="resCheckIn" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Check-out" />
                        <DatePicker fx:id="resCheckOut" maxWidth="Infinity" />
                    </VBox>
                </HBox>

                <HBox spacing="16">
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Adults" />
                        <Spinner fx:id="resAdults" editable="false" prefWidth="110" />
                    </VBox>
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Children" />
                        <Spinner fx:id="resChildren" editable="false" prefWidth="110" />
                    </VBox>
                </HBox>

                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555555;"
                       text="Room Selection" />
                <HBox spacing="24">
                    <VBox alignment="CENTER" spacing="5">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Single ($150/night)" />
                        <Spinner fx:id="resSingleRoom" editable="false" prefWidth="90" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="5">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Double ($250/night)" />
                        <Spinner fx:id="resDoubleRoom" editable="false" prefWidth="90" />
                    </VBox>
                    <VBox alignment="CENTER" spacing="5">
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Penthouse ($400/night)" />
                        <Spinner fx:id="resDeluxeRoom" editable="false" prefWidth="90" />
                    </VBox>
                </HBox>

                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #555555;"
                       text="Add-On Services" />
                <HBox spacing="24">
                    <CheckBox fx:id="resWifi"      onAction="#updatePricePreview" text="Wi-Fi ($10 flat)" />
                    <CheckBox fx:id="resBreakfast" onAction="#updatePricePreview" text="Breakfast ($20/night)" />
                    <CheckBox fx:id="resParking"   onAction="#updatePricePreview" text="Parking ($15/night)" />
                    <CheckBox fx:id="resSpa"       onAction="#updatePricePreview" text="Spa ($50 flat)" />
                </HBox>

            </VBox>

            <!-- Price summary -->
            <VBox prefWidth="280" spacing="8"
                  style="-fx-background-color: #ffffff;
                         -fx-border-color: #c9a84c; -fx-border-width: 1.5;
                         -fx-border-radius: 10; -fx-background-radius: 10;
                         -fx-padding: 24;">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold;
                              -fx-text-fill: #c9a84c; -fx-letter-spacing: 1px;"
                       text="Price Summary" />
                <Label fx:id="previewRooms"    style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Rooms: —" />
                <Label fx:id="previewNights"   style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Nights: —" />
                <Label fx:id="previewStrategy" style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Rate: Standard" />
                <Label fx:id="previewAddOns"   style="-fx-font-size: 12px; -fx-text-fill: #888888;" text="Add-ons: none" />
                <Separator />
                <Label fx:id="previewSubtotal" style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Subtotal: —" />
                <Label fx:id="previewTax"      style="-fx-font-size: 13px; -fx-text-fill: #555555;" text="Tax (13%): —" />
                <Separator />
                <Label fx:id="resTotalLabel"
                       text="Total: —"
                       maxWidth="Infinity"
                       minWidth="-1"
                       prefWidth="-1"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #c9a84c;" />
            </VBox>

        </HBox>

        <Button onAction="#handleCreateReservation"
                style="-fx-background-color: #c9a84c; -fx-text-fill: #ffffff;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-padding: 13 36; -fx-background-radius: 8; -fx-cursor: hand;"
                text="Create Reservation" />

        <StackPane alignment="CENTER_LEFT" minHeight="36">
            <Label fx:id="resSuccessLabel"
                   style="-fx-font-size: 13px; -fx-text-fill: #2e7d32;
                          -fx-background-color: #e8f5e9;
                          -fx-padding: 10 16; -fx-background-radius: 6;"
                   text="" visible="false" />
            <Label fx:id="resErrorLabel"
                   style="-fx-font-size: 13px; -fx-text-fill: #c62828;"
                   text="" visible="false" />
        </StackPane>

    </VBox>
</ScrollPane>
