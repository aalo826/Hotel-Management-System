<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="900" prefWidth="1400"
            style="-fx-background-color: #ffffff;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ca.senecacollege.application.hotelmanagementsystem.controller.AdminController">

    <!--
        Each tab embeds its own FXML file via fx:include.
        JavaFX automatically injects the included file's controller into
        AdminController using the fx:id + "Controller" naming convention:
            fx:id="dashboard"  →  @FXML DashboardController dashboardController
    -->

    <TabPane fx:id="mainTabPane"
             style="-fx-background-color: #f7f5f0;
                    -fx-tab-min-width: 120;
                    -fx-tab-max-width: 160;"
             tabClosingPolicy="UNAVAILABLE"
             AnchorPane.bottomAnchor="0"
             AnchorPane.leftAnchor="0"
             AnchorPane.rightAnchor="0"
             AnchorPane.topAnchor="0">

        <!-- TAB 1: DASHBOARD -->
        <Tab text="Dashboard">
            <fx:include fx:id="dashboard"
                        source="dashboard-view.fxml" />
        </Tab>

        <!-- TAB 2: RESERVATIONS -->
        <Tab text="Reservations">
            <fx:include fx:id="reservation"
                        source="reservation-view.fxml" />
        </Tab>

        <!-- TAB 3: PAYMENTS -->
        <Tab text="Payments">
            <fx:include fx:id="payment"
                        source="payment-view.fxml" />
        </Tab>

        <!-- TAB 4: WAITLIST -->
        <Tab text="Waitlist">
            <fx:include fx:id="waitlist"
                        source="waitlist-view.fxml" />
        </Tab>

        <!-- TAB 5: FEEDBACK -->
        <Tab text="Feedback">
            <fx:include fx:id="feedback"
                        source="feedbackadmin-view.fxml" />
        </Tab>

        <!-- TAB 6: REPORTS -->
        <Tab text="Reports">
            <fx:include fx:id="reports"
                        source="reports-view.fxml" />
        </Tab>

    </TabPane>

</AnchorPane>
